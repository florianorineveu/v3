{% extends 'admin/layout/base.html.twig' %}

{% block body %}
    <h1>ShortUrl</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ short_url.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ short_url.name }}</td>
            </tr>
            <tr>
                <th>Url</th>
                <td>{{ short_url.url }}</td>
            </tr>
            <tr>
                <th>ShortenUrl</th>
                <td>{{ short_url.slug }}</td>
            </tr>
            <tr>
                <th>Enabled</th>
                <td>{{ short_url.enabled ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Used</th>
                <td>{{ short_url.used }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ short_url.createdAt ? short_url.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ short_url.updatedAt ? short_url.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_short_url_index') }}">back to list</a>

    <a href="{{ path('admin_short_url_edit', {'id': short_url.id}) }}">edit</a>

    {{ include('admin/short_url/_delete_form.html.twig') }}
{% endblock %}
