<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}IO{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('admin') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('admin') }}
    {% endblock %}
</head>
<body>
    {{ include('backend/layout/_header.html.twig') }}

    {{ include('backend/layout/_sidebar.html.twig') }}

    {% if block('body') is defined %}
        <main id="body">
            {% block body %}{% endblock %}
        </main>
    {% endif %}

    {{ include('backend/layout/_footer.html.twig') }}
</body>
</html>
