{{ form_start(form) }}
    <div class="form-section">
        <h2 class="form-section__title">Informations</h2>
        {{ form_row(form.title) }}
        {{ form_row(form.slug) }}
        {{ form_row(form.category) }}
        <div class="form-row form-row--inline">
            {{ form_row(form.publishedAt) }}
            {{ form_row(form.enabled) }}
        </div>
    </div>

    <div class="form-section">
        <h2 class="form-section__title">Contenu</h2>
        {{ include('backend/components/content_block/_collection.html.twig', {
            form: form.contentBlocks,
            available_types: available_types|default({
                'text': 'Texte enrichi',
                'code': 'Code',
                'quote': 'Citation',
                'callout': 'Encadré',
                'divider': 'Séparateur'
            })
        }) }}
    </div>

    <div class="form-actions">
        <button class="btn">{{ button_label|default('Enregistrer') }}</button>
    </div>
{{ form_end(form) }}
