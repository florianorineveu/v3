# EditorConfig helps maintain consistent coding styles across editors and IDEs
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP files
[*.php]
indent_size = 4

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_size = 4

# JSON
[*.json]
indent_size = 2

# YAML (including Docker Compose)
[*.{yml,yaml}]
indent_size = 4

[{compose.yaml,compose.*.yaml}]
indent_size = 2

# CSS/SCSS/Sass
[*.{css,scss,sass}]
indent_size = 4

# Twig templates
[*.twig]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Composer/NPM lock files (don't modify)
[{composer.lock,package-lock.json,yarn.lock}]
insert_final_newline = false
indent_size = unset
indent_style = unset
